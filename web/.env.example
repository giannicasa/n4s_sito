# MongoDB Atlas: stesso cluster del backend, database dedicato al CMS
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/n4s_cms?retryWrites=true&w=majority
# Stringa casuale lunga (openssl rand -hex 32)
PAYLOAD_SECRET=
# URL pubblico del sito (in locale http://localhost:3100)
NEXT_PUBLIC_SITE_URL=https://not4.sale
# Backend FastAPI esistente (contatti, chat AI, preventivo)
BACKEND_ORIGIN=https://n4s-backend.vercel.app
# Vercel Blob per le immagini caricate dal CMS (obbligatorio in produzione)
BLOB_READ_WRITE_TOKEN=
